# Full: personal apps on top of the core Brewfile (./install.sh --full).
# Mac App Store entries require being signed in to the App Store beforehand.

tap "teamookla/speedtest"

# --- CLI utilities ---
brew "diceware"
brew "dnsmasq"
brew "mkdocs"
brew "pinentry-mac"
brew "teamookla/speedtest/speedtest"
brew "mas"

# --- Apps ---
cask "claude"
cask "cleanupbuddy"
cask "macpacker"
cask "raycast"
cask "surfshark"
cask "thorium"
cask "transmission"
cask "transmit"
cask "vorssaint"
cask "whatsapp"

# --- Mac App Store ---
mas "Bear", id: 1091189122
mas "Klack", id: 6446206067
mas "Pixelmator Pro", id: 1289583905
mas "Tailscale", id: 1475387142
mas "The Unarchiver", id: 425424353
