# Core: development environment. Installed by default (./install.sh).
# Personal apps live in Brewfile.full (./install.sh --full).

# --- Version control ---
brew "git"
brew "gh"

# --- Runtimes ---
brew "node"
brew "bun"
brew "go"
brew "php"

# --- Databases & local dev ---
brew "dbmate"
brew "mkcert"
brew "mysql-client" # keg-only: PATH is set in the shell config

# --- Repo tooling (tests & lint for this repo) ---
brew "bats-core"
brew "shellcheck"

# --- Terminal ---
cask "ghostty"
brew "herdr"

# --- Editor & containers (OrbStack provides docker / docker compose) ---
cask "visual-studio-code"
cask "orbstack"

# --- Fonts (IosevkaTerm Nerd Font: Ghostty + VS Code; its glyphs cover powerlevel10k) ---
cask "font-iosevka-term-nerd-font"
